{
  "header": { "apiLevel": 8, "width": 400, "height": 330, "densityBehavior": 2 },
  "root": { "column": {
    "modifiers": ["fillMaxSize", { "padding": { "start": 16, "end": 16 } }],
    "children": [
      { "column": {
        "modifiers": ["fillMaxSize", { "clip": { "roundedrect": 28 } }, { "background": "{{color}}" }, { "padding": [18, 16] }],
        "children": [
          { "text": { "value": "{{badge}}", "fontSize": 13, "fontWeight": 600, "color": "#FFFFE7A3" } },
          { "text": { "value": "{{title}}", "fontSize": 30, "fontWeight": 800, "color": "#FFFFFFFF" } },
          { "$rows": "one row per drink in stage.json → promo.drinks, generated by the server" },
          { "text": { "value": "built from JSON on the server", "modifiers": [{ "padding": { "top": 10 } }], "fontSize": 11, "color": "#B3FFFFFF" } }
        ]
      } }
    ]
  } }
}
